### Variáveis
@baseUrl = http://localhost:8080

### Inserir novo usuário
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com",
  "password": "password123"
}

### Inserir segundo usuário
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "password": "securepass456"
}

### Buscar usuário por email
GET {{baseUrl}}/users/email?email=john.doe@example.com

### Listar todos os jogos
GET {{baseUrl}}/games

### Listar listas de jogos
GET {{baseUrl}}/lists

### Buscar jogo por ID
GET {{baseUrl}}/games/id?id=1

### Buscar jogo por título
GET {{baseUrl}}/games/title?title=Mass

### Fazer login e obter token
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "john.doe@example.com",
  "password": "password123"
}

### Obter dados do usuário autenticado
GET {{baseUrl}}/users/me
Authorization: Bearer seu_token_aqui

### Atualizar apenas password do usuário
PATCH {{baseUrl}}/users/1
Content-Type: application/json

{
  "password": "newpassword789"
}

### Deletar usuário por ID
DELETE {{baseUrl}}/users/1

### Atualizar todas as informações do jogo
PATCH {{baseUrl}}/games/1
Content-Type: application/json

{
  "title": "The Witcher 3: Wild Hunt",
  "imgUrl": "https://raw.githubusercontent.com/devsuperior/java-sds1-assets/main/ds-catalog/img3-big.jpg",
  "score": 9.2,
  "year": 2015,
  "genre": "Role-Playing Game",
  "platforms": "PC, PlayStation 4, Xbox One",
  "description": "As a witcher, you must track down contract murders and slain beasts for profit."
}

### Deletar jogo por ID
DELETE {{baseUrl}}/games/1